# ==========================================
# FinFlow Backend - Environment Variables
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Supabase Project Settings
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for client use, used here only for optional flows)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (SECRET - server-side only, bypasses Row Level Security)
# Never expose this to the frontend or commit it to source control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used by Supabase to sign auth tokens.
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings
# Used as a fallback to locally verify token signatures without an API round-trip.
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS
# Comma separated list of allowed origins for the frontend app(s)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase Storage bucket used for receipt / avatar uploads
SUPABASE_STORAGE_BUCKET=finflow-uploads

# Max upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880
