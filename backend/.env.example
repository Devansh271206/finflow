# ==========================================
# FinFlow Backend - Environment Variables
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Supabase Project Settings
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for client use, used here only for optional flows)
SUPABASE_ANON_KEY=your-anon-key

# Service role key (SECRET - server-side only, bypasses Row Level Security)
# Never expose this to the frontend or commit it to source control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret used by Supabase to sign auth tokens.
# Found in Supabase Dashboard -> Project Settings -> API -> JWT Settings
# Used as a fallback to locally verify token signatures without an API round-trip.
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS
# Comma separated list of allowed origins for the frontend app(s)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Supabase Storage bucket used for receipt / avatar uploads
SUPABASE_STORAGE_BUCKET=finflow-uploads

# Max upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880

# Email delivery for invitations + password reset (PRD 30.2 / 30.3).
# EMAIL_PROVIDER is one of: resend | smtp | console (console = dev only,
# logs to stdout instead of sending; rejected in production).

# --- DEV / TEST (no custom domain required) -----------------------------
# Resend's shared test sender. IMPORTANT: it can ONLY deliver to the email
# address of your Resend account. To test invite/reset flows against any
# email, also set EMAIL_DEV_OVERRIDE_RECIPIENT to your own inbox — every
# email is then delivered there (dev only, rejected in production). The
# real provider response is still returned; nothing is faked.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM="FinFlow <onboarding@resend.dev>"
# EMAIL_DEV_OVERRIDE_RECIPIENT=you@example.com

# --- PRODUCTION (verified domain required for real recipients) ----------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM="FinFlow <noreply@your-verified-domain.com>"

# --- SMTP alternative ----------------------------------------------------
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# EMAIL_FROM="FinFlow <noreply@your-verified-domain.com>"

# Public origin of the deployed frontend, used as the base for emailed
# links (invitation accept, password reset). Vercel URL in production.
# FRONTEND_URL=https://your-frontend.vercel.app
